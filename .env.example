# Copy to .env.local for local development. All values are read on the server
# at build time (pages are prerendered), so change them in Render and redeploy.

# Canonical origin used for metadata, sitemap, robots and JSON-LD. No trailing slash.
SITE_URL=https://aakrin.com

# "true" only on the production domain. Anything else sends noindex and a
# disallow-all robots.txt, so Render preview/onrender.com URLs stay out of search.
ALLOW_INDEXING=false

# Analytics providers. Each one loads only when its ID is set; all are off by default.
# Do not enable them until cookie consent has been decided.

# Microsoft Clarity project ID. The previous site used: ym7dl733c2
CLARITY_PROJECT_ID=

# Apollo website tracker app ID. The previous site used: 6819ca5be4098f001573dd60
APOLLO_APP_ID=

# Nova onboarding (quiz + enquiry form): every visit to "/", /start, "Tell us what you need". Off unless "true".
FEATURE_QUIZ=false

# Salesforce Web-to-Lead org id (public by design: it is sent with every form post).
WEB_TO_LEAD_ORG_ID=00DdN00000rD67Y

# Optional. Salesforce emails a debug report for each submission to this address.
# Testing only: ignored whenever ALLOW_INDEXING=true, so it can never run in production.
WEB_TO_LEAD_DEBUG_EMAIL=

# Optional. JSON map of quiz context to Lead custom field ids, e.g.
# {"situation":"00N...","requirement":"00N...","utm_source":"00N..."}
# Keys: source, placement, situation, requirement, utm_source, utm_medium, utm_campaign,
# utm_term, utm_content, landing_page, referrer. Context is always in Description too.
WEB_TO_LEAD_CONTEXT_FIELDS=
